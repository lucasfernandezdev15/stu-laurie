{
  "name": "stu-laurie-streaming",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@expo/metro-runtime": "~57.0.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "expo": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.1",
    "hls.js": "^1.6.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86-stable",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.6",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "http-proxy-middleware": "^3.0.7",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:tv": "cross-env EXPO_PUBLIC_FORCE_TV=1 expo start --web",
    "export:web": "expo export -p web",
    "prebuild": "expo prebuild --clean",
    "prebuild:tv": "cross-env EXPO_TV=1 expo prebuild --clean",
    "run:android:tv": "cross-env EXPO_TV=1 expo run:android",
    "run:ios:tv": "cross-env EXPO_TV=1 expo run:ios",
    "apk:phone": "node scripts/build-android.mjs",
    "apk:tv": "node scripts/build-android.mjs --tv",
    "apk:phone:clean": "node scripts/build-android.mjs --clean",
    "apk:tv:clean": "node scripts/build-android.mjs --tv --clean",
    "apk:phone:all-abis": "node scripts/build-android.mjs --all-abis",
    "apk:tv:all-abis": "node scripts/build-android.mjs --tv --all-abis",
    "cloud:android": "eas build -p android --profile preview",
    "cloud:androidtv": "eas build -p android --profile preview_tv",
    "cloud:ios": "eas build -p ios --profile preview",
    "cloud:appletv": "eas build -p ios --profile preview_tv"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  },
  "private": true
}
